<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardBranchItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_branch_item_unselected"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header line: Branch Name + Selection indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBranchIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_teal"
            android:padding="8dp"
            android:src="@drawable/ic_hotel_building"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemBranchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Grand Orchid - Sector 14"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemBranchTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Main Branch • ID #101"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Selected check indicator -->
        <ImageView
            android:id="@+id/ivSelectedCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_check_circle_outline_24"
            android:visibility="gone"
            app:tint="@color/Text_Blue" />

        <TextView
            android:id="@+id/tvActiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_green_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="CURRENT"
            android:textColor="#15803D"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Address row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/location_on_24"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tvItemBranchAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Plot 42, DLF Phase 2, Near MG Road, Gurgaon"
            android:textColor="#475569"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Details chips: Rooms, Category, Type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemBranchRooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_light_gray"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="50 Rooms"
            android:textColor="#334155"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvItemBranchStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_rounded_light_gray"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="4-Star Luxury"
            android:textColor="#334155"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvItemBranchPropertyType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_rounded_light_gray"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Hotel"
            android:textColor="#334155"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
