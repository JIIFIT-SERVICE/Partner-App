<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    tools:context=".Influencer.InfluencerPrivacyPolicyActivity">

    <!-- Top Blue Gradient Header Banner -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_influencer_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp">

        <!-- Top Badges & Back Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/arrow_back"
                app:tint="@android:color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Policy Pill Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_partner_guaranteed_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="PRIVACY &amp; DATA SECURITY"
                android:textColor="@android:color/white"
                android:textSize="10.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Header Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false"
            android:text="Privacy Policy"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:text="JIIFIT Partner &amp; Influencer Privacy Protection"
            android:textColor="#E0E7FF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Scrollable Privacy Policy Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp">

            <!-- Overview Banner Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_clean"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Privacy Policy"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="At JIIFIT, we value your privacy and are committed to protecting your personal information."
                    android:textColor="#334155"
                    android:textSize="13.5sp"
                    android:textStyle="normal" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#F1F5F9" />

                <!-- Highlight Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_step_circle"
                        android:backgroundTint="#059669"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="✓"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="End-to-end encrypted partner transactions &amp; payouts"
                        android:textColor="#059669"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Highlight Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_step_circle"
                        android:backgroundTint="#0D62FE"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="✓"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="We never sell your personal information"
                        android:textColor="#0D62FE"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Privacy Policy Clauses Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_clean"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- 1. Information We Collect -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="1. Information We Collect"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="We may collect your name, phone number, email address, account details, booking information, and referral activity when you use our app."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- 2. How We Use Your Information -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="2. How We Use Your Information"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="We use your information to manage your account, process bookings, provide customer support, track referrals, credit wallet balance, and process eligible partner rewards."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- 3. Payment and Referral Information -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="3. Payment and Referral Information"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="We may process transaction details and verified bank or UPI information to manage payments and partner payouts. Referral information is used to verify eligible registrations and bookings."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- 4. Sharing of Information -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="4. Sharing of Information"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="We may share necessary information with service providers, payment partners, and authorized parties to operate our services or meet legal obligations. We do not sell your personal information as a standalone commercial product."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- 5. Data Security -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="5. Data Security"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="We take reasonable measures to protect your information against unauthorized access, misuse, loss, or disclosure. However, no digital system can be guaranteed to be completely secure."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- 6. Data Retention -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="6. Data Retention"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="We retain personal information only as long as reasonably necessary to provide our services, manage transactions, resolve disputes, and comply with applicable laws."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- 7. Your Privacy Rights -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="7. Your Privacy Rights"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="You may contact us to request access to, correction of, or deletion of your personal information, subject to applicable law and necessary recordkeeping requirements."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- 8. Policy Updates -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="8. Policy Updates"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="We may update this Privacy Policy from time to time. Any changes will be published in the app, with notice or consent where required by law."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- 9. Contact Us -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="9. Contact Us"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="For privacy-related questions or requests, contact us at jiifitteam@gmail.com."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

            </LinearLayout>

            <!-- Metadata & Company Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_clean"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Effective Date: "
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="October 28, 2026"
                        android:textColor="#1E293B"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Company Name: "
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="JIIFIT Technologies"
                        android:textColor="#1E293B"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Support Email Contact Action -->
            <LinearLayout
                android:id="@+id/btnSupportEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_clean"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/baseline_email_24"
                    app:tint="#0D62FE" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Have a privacy question?"
                        android:textColor="#1E293B"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="Tap to email jiifitteam@gmail.com"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="#0D62FE" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Footer Container with Accept Button -->
    <LinearLayout
        android:id="@+id/privacyFooterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#0D62FE"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="I Understand &amp; Agree"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15.5sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>

