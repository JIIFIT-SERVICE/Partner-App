<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Hotel Branch"
        android:textColor="#1E293B"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Enter branch details to register another location"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etNewBranchName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_edit_hotel_input"
        android:hint="Branch Name (e.g., Grand Orchid - Sohna Rd)"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="#1E293B"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etNewBranchTag"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_edit_hotel_input"
        android:hint="Branch Tag (e.g., Sohna Road Branch)"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="#1E293B"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etNewBranchLocality"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_hotel_input"
            android:hint="Locality (e.g., Sector 48)"
            android:inputType="textCapWords"
            android:paddingHorizontal="14dp"
            android:textColor="#1E293B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etNewBranchCity"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_hotel_input"
            android:hint="City (e.g., Gurgaon)"
            android:inputType="textCapWords"
            android:paddingHorizontal="14dp"
            android:textColor="#1E293B"
            android:textSize="14sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etNewBranchAddress"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_edit_hotel_input"
        android:gravity="top|start"
        android:hint="Full Address"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="#1E293B"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etNewBranchRooms"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_edit_hotel_input"
        android:hint="Total Rooms (e.g., 45)"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:textColor="#1E293B"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelNewBranch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_cancel"
            android:text="Cancel"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveNewBranch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_btn_save"
            android:paddingHorizontal="20dp"
            android:text="Add Branch"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
