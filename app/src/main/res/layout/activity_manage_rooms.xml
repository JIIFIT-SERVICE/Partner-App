<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- Back Link Button -->
        <LinearLayout
            android:id="@+id/btnBackToDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/arrow_back_24"
                app:tint="#0B4F4F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Back to Concierge Dashboard"
                android:textColor="#0B4F4F"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Title Row: Manage Hotel Rooms + Towers Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvManageRoomsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Manage Hotel Rooms\n(140 Keys)"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- East & West Towers Badge -->
            <TextView
                android:id="@+id/tvTowersBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_towers"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="East &amp; West\nTowers"
                android:textColor="#0F766E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtitle description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="Quick concierge booking by room number. Tap any room to dispatch In-Room Massage, Yoga, or Ayurveda."
            android:textColor="#64748B"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#E2E8F0" />
    </LinearLayout>

    <!-- Floor Selector Horizontal Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutFloorTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>
    </LinearLayout>

    <!-- Rooms Grid Section -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoomsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        tools:listitem="@layout/item_manage_room_card" />

</LinearLayout>
