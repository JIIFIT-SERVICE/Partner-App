<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Legal &amp; Contact"
                android:textColor="#172B26"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tell us about your property and how we can contact you"
                android:textColor="#71807B"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- HOTEL TYPE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="#E3E9E6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- SECTION HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardBackgroundColor="@color/BackgroundBlue"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:src="@drawable/ic_menu_map"
                            app:tint="@color/Electric_Blue" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Property Type"
                            android:textColor="#172B26"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Select the type of property"
                            android:textColor="#84908C"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- HOTEL TYPE -->
                <RadioGroup
                    android:id="@+id/rgHotelType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbHotel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Hotel"
                        android:textColor="#34413D"
                        android:textSize="15sp"
                        app:buttonTint="@color/Electric_Blue" />

                    <RadioButton
                        android:id="@+id/rbBoutique"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Boutique"
                        android:textColor="#34413D"
                        android:textSize="15sp"
                        app:buttonTint="@color/Electric_Blue" />

                    <RadioButton
                        android:id="@+id/rbResort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Resort"
                        android:textColor="#34413D"
                        android:textSize="15sp"
                        app:buttonTint="@color/Electric_Blue" />

                    <RadioButton
                        android:id="@+id/rbServiceApt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Service Apartment"
                        android:textColor="#34413D"
                        android:textSize="15sp"
                        app:buttonTint="@color/Electric_Blue" />

                    <RadioButton
                        android:id="@+id/rbHomestay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Home Stay"
                        android:textColor="#34413D"
                        android:textSize="15sp"
                        app:buttonTint="@color/Electric_Blue" />

                </RadioGroup>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- LEGAL & CONTACT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="#E3E9E6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- CARD TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Legal &amp; Contact Details"
                    android:textColor="#172B26"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="18dp"
                    android:text="Provide your registration and contact information"
                    android:textColor="#84908C"
                    android:textSize="12sp" />


                <!-- GST / PAN LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="Hotel Member / GST / PAN"
                    android:textColor="#34413D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- GST / PAN -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/Electric_Blue"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHotelMember"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter GST or PAN number"
                        android:inputType="textCapCharacters"
                        android:paddingStart="14dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="15dp"
                        android:textColor="@color/black"
                        android:textColorHint="#9AA5A1"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- EMAIL LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="Email Address"
                    android:textColor="#34413D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- EMAIL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/Electric_Blue"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWhatsAppEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter your email address"
                        android:inputType="textEmailAddress"
                        android:paddingStart="14dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="15dp"
                        android:textColor="@color/black"
                        android:textColorHint="#9AA5A1"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- INFO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/BackgroundBlue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/Electric_Blue" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Please provide accurate legal and contact information for verification."
                android:textColor="@color/Electric_Blue"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>