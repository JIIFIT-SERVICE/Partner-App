# ------------------------------------------------------------------------------
# Apache & PHP Configuration for Jifiit Therapist Registration
# Increases maximum HTTP request payload and upload file size to 20MB
# ------------------------------------------------------------------------------

# Apache Request Body Limit (20 MB in bytes)
LimitRequestBody 20971520

# PHP 8.x and general mod_php settings
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
    php_value memory_limit 128M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
    php_value memory_limit 128M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
    php_value memory_limit 128M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

