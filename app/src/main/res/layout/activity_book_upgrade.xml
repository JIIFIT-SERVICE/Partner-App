<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White"
    tools:context=".ViewMoreMenu.BookUpgradeActivity">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="@color/ShapGreen"
      android:elevation="4dp"
      android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

  <!-- ScrollView wraps the content you want to scroll -->
  <ScrollView
      android:id="@+id/scrollable"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:layout_constraintTop_toBottomOf="@id/toolbar"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintBottom_toTopOf="@id/footer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

      <TextView
          android:id="@+id/productName"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="3dp"
          android:gravity="center"
          android:padding="@dimen/_8sdp"
          android:textStyle="bold"
          android:textColor="@color/ShapGreen"
          android:text="reboot Body and Mind Package"
          android:textSize="@dimen/_13ssp" />

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/cart_category"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:visibility="gone" /> <!-- Initially hidden -->

      <!-- ProgressBar -->
      <ProgressBar
          android:id="@+id/progressBar"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:indeterminate="true"
          android:visibility="visible" />

      <androidx.cardview.widget.CardView
          xmlns:android="http://schemas.android.com/apk/res/android"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="16dp"
          app:cardCornerRadius="8dp"
          app:cardElevation="4dp"
          android:visibility="gone"
          android:backgroundTint="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <!-- Payment Summary Title -->
          <TextView
              android:id="@+id/payment_summary_title"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Payment Summary"
              android:textStyle="bold"
              android:textSize="18sp"
              android:textColor="#333333" />

          <!-- Selected by you -->
          <TextView
              android:id="@+id/selected_by_you"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Selected by you"
              android:textSize="14sp"
              android:textColor="#666666"
              android:layout_marginTop="8dp"/>

          <!-- Massage Name and Prices Table -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_marginTop="12dp">

            <!-- First Item: Massage Name, Original Price, Discounted Price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

              <TextView
                  android:id="@+id/massage_name_1"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:text="Refreshing Acupressure Massage (90 minutes)"
                  android:textSize="14sp"
                  android:textColor="#333333" />

              <TextView
                  android:id="@+id/original_price_1"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="₹000.00"
                  android:textSize="14sp"
                  android:textColor="#999999"
                  />

              <TextView
                  android:id="@+id/discounted_price_1"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="₹0000.00"
                  android:textSize="14sp"
                  android:layout_marginStart="16dp"
                  android:textColor="#333333" />
            </LinearLayout>

            <!-- Second Item: Massage Name, Original Price, Discounted Price -->

            <!-- Service Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

              <TextView
                  android:id="@+id/service_total_label"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:text="Service Total"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:textColor="#333333" />

              <TextView
                  android:id="@+id/service_total_original"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="₹0000.00"
                  android:textSize="14sp"
                  android:textColor="#999999"
               />

              <TextView
                  android:id="@+id/service_total_discounted"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="₹0000.00"
                  android:textSize="14sp"
                  android:layout_marginStart="16dp"
                  android:textColor="#333333" />
            </LinearLayout>

          </LinearLayout>

        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="8dp"
          android:backgroundTint="#FFFFFF"
          app:cardCornerRadius="8dp"
          app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/_10sdp"
            android:padding="16dp">

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Details about your Service"
              android:textColor="#4E6761"
              android:gravity="center"
              android:textSize="@dimen/_15sdp"
              android:textStyle="bold"
              android:padding="@dimen/_2sdp"/>

          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="8dp"
              android:backgroundTint="#FFFFFF"
              app:cardCornerRadius="8dp"
              app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_10sdp"
                android:padding="16dp">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginBottom="8dp">

                <!-- Service Icon -->
                <ImageView
                    android:id="@+id/coverImage"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_gravity="start"
                    android:layout_marginEnd="8dp"
                    />

                <!-- Service Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cover"
                    android:textColor="#4E6761"
                    android:textSize="16sp"
                    android:textStyle="bold" />
              </LinearLayout>

              <!-- Service Description -->
              <TextView
                  android:id="@+id/coverDescription"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:textColor="#7A8E8C"
                  android:textSize="14sp" />

            </LinearLayout>
          </androidx.cardview.widget.CardView>
          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="8dp"
              android:backgroundTint="#FFFFFF"
              app:cardCornerRadius="8dp"
              app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_10sdp"
                android:padding="16dp">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginBottom="8dp">

                <!-- Service Icon -->
                <ImageView
                    android:id="@+id/techniqueImage"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_gravity="start"
                    android:layout_marginEnd="8dp"
                    />

                <!-- Service Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Technique"
                    android:textColor="#4E6761"
                    android:textSize="16sp"
                    android:textStyle="bold" />
              </LinearLayout>

              <!-- Service Description -->
              <TextView
                  android:id="@+id/techniqueDescription"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:textColor="#7A8E8C"
                  android:textSize="14sp" />

            </LinearLayout>
          </androidx.cardview.widget.CardView>
          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="8dp"
              android:backgroundTint="#FFFFFF"
              app:cardCornerRadius="8dp"
              app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_10sdp"
                android:padding="16dp">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginBottom="8dp">

                <!-- Service Icon -->
                <ImageView
                    android:id="@+id/pressureImage"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_gravity="start"
                    android:layout_marginEnd="8dp"
                   />

                <!-- Service Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pressure"
                    android:textColor="#4E6761"
                    android:textSize="16sp"
                    android:textStyle="bold" />
              </LinearLayout>

              <!-- Service Description -->
              <TextView
                  android:id="@+id/pressureDescription"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:textColor="#7A8E8C"
                  android:textSize="14sp" />

            </LinearLayout>
          </androidx.cardview.widget.CardView>
          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="8dp"
              android:backgroundTint="#FFFFFF"
              app:cardCornerRadius="8dp"
              app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_10sdp"
                android:padding="16dp">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginBottom="8dp">

                <!-- Service Icon -->
                <ImageView
                    android:id="@+id/oilImage"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_gravity="start"
                    android:layout_marginEnd="8dp"
                    />

                <!-- Service Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oil"
                    android:textColor="#4E6761"
                    android:textSize="16sp"
                    android:textStyle="bold" />
              </LinearLayout>

              <!-- Service Description -->
              <TextView
                  android:id="@+id/OilDescription"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:textColor="#7A8E8C"
                  android:textSize="14sp" />

            </LinearLayout>
          </androidx.cardview.widget.CardView>
          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="8dp"
              android:backgroundTint="#FFFFFF"
              app:cardCornerRadius="8dp"
              app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_10sdp"
                android:padding="16dp">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginBottom="8dp">

                <!-- Service Icon -->
                <ImageView
                    android:id="@+id/benifitsImage"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_gravity="start"
                    android:layout_marginEnd="8dp"
                    />

                <!-- Service Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Benefits"
                    android:textColor="#4E6761"
                    android:textSize="16sp"
                    android:textStyle="bold" />
              </LinearLayout>

              <!-- Service Description -->
              <TextView
                  android:id="@+id/BenefitsDescription"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:textColor="#7A8E8C"
                  android:textSize="14sp" />

            </LinearLayout>
          </androidx.cardview.widget.CardView>
          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="8dp"
              android:backgroundTint="#FFFFFF"
              app:cardCornerRadius="8dp"
              app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_10sdp"
                android:padding="16dp">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginBottom="8dp">

                <!-- Service Icon -->
                <ImageView
                    android:id="@+id/recommendedImage"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_gravity="start"
                    android:layout_marginEnd="8dp"
                    />

                <!-- Service Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recommended For"
                    android:textColor="#4E6761"
                    android:textSize="16sp"
                    android:textStyle="bold" />
              </LinearLayout>

              <!-- Service Description -->
              <TextView
                  android:id="@+id/RecommendedDescription"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:textColor="#7A8E8C"
                  android:textSize="14sp" />

            </LinearLayout>
          </androidx.cardview.widget.CardView>
        </LinearLayout>
      </androidx.cardview.widget.CardView>

    </LinearLayout>

  </ScrollView>

  <LinearLayout
      android:id="@+id/footer"
      android:layout_width="match_parent"
      android:layout_height="@dimen/_35sdp"
      android:layout_alignParentBottom="true"
      android:orientation="horizontal"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.01"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/scrollable">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="Total: "
        android:layout_marginStart="@dimen/_10sdp"
        android:gravity="center"
        android:textColor="@color/Blue"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold" />
        <TextView
        android:id="@+id/totalMoney"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:drawableTint="@color/Blue"
        android:layout_marginRight="@dimen/_10sdp"
        android:gravity="center"
        android:textColor="@color/Blue"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold" />
    <Button
        android:id="@+id/orderBtn"
        android:layout_width="@dimen/_70sdp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginLeft="@dimen/_75sdp"
        android:text="Place"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/_10ssp"
        android:textStyle="bold" />
  </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
