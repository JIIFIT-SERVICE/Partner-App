<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E0E4E8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="28dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No appointments for this selection"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Switch date tab or create a new desk booking using the button below."
            android:textSize="13sp"
            android:textColor="#757575"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

        <!-- Add Desk Booking Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddDeskBooking"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:text="Add Desk Booking"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="20dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:backgroundTint="#1E3A8A"
            app:cornerRadius="22dp"
            app:elevation="0dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>