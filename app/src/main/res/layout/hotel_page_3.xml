<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hotel Details"
                android:textColor="#172B26"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Add your property details and supporting documents"
                android:textColor="#71807B"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- LEGAL DOCUMENT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="#E3E9E6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- TITLE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardBackgroundColor="#E3F0FF"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:src="@android:drawable/ic_menu_upload"
                            app:tint="@color/Electric_Blue" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Legal Document"
                            android:textColor="#172B26"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Upload your property document"
                            android:textColor="#84908C"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- UPLOAD BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadDocument"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Upload Legal Document"
                    android:textAllCaps="false"
                    android:textColor="@color/Electric_Blue"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#E3F0FF"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_upload"
                    app:iconGravity="textStart"
                    app:iconTint="@color/Electric_Blue"
                    app:strokeColor="@color/Electric_Blue"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- PROPERTY DETAILS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="#E3E9E6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- CARD TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Property Details"
                    android:textColor="#172B26"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="20dp"
                    android:text="Tell us a little more about your hotel"
                    android:textColor="#84908C"
                    android:textSize="12sp" />


                <!-- Hotel Category - Slider Style -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Hotel Category"
                        android:textColor="#34413D"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Range Slider -->
                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/rsHotelCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1"
                        android:valueTo="5"
                        android:stepSize="1"
                        android:value="1"
                        app:thumbRadius="16dp"
                        app:trackHeight="8dp"
                        app:haloRadius="0dp"
                        app:thumbColor="@color/Electric_Blue"
                        app:trackColorActive="@color/Electric_Blue"
                        app:trackColorInactive="@color/BackgroundBlue"
                        app:labelBehavior="gone"
                        app:labelStyle="@style/Widget.MaterialComponents.Slider.Label"
                        android:layout_marginBottom="8dp" />

                    <!-- Star Labels -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="5">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⭐ 1"
                            android:textSize="12sp"
                            android:textColor="#71807B"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⭐ 2"
                            android:textSize="12sp"
                            android:textColor="#71807B"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⭐ 3"
                            android:textSize="12sp"
                            android:textColor="#71807B"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⭐ 4"
                            android:textSize="12sp"
                            android:textColor="#71807B"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⭐ 5"
                            android:textSize="12sp"
                            android:textColor="#71807B"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- Selected Value Display -->
                    <TextView
                        android:id="@+id/tvSelectedStar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Selected: ⭐ 1 Star"
                        android:textSize="14sp"
                        android:textColor="#34413D"
                        android:gravity="center"
                        android:background="@color/BackgroundBlue"
                        android:padding="8dp"
                        android:visibility="visible" />

                </LinearLayout>


                <!-- ESTABLISHMENT YEAR LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="Year of Establishment"
                    android:textColor="#34413D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- ESTABLISHMENT YEAR -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/Electric_Blue"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEstablishmentYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 2018"
                        android:inputType="number"
                        android:maxLength="4"
                        android:paddingStart="14dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="15dp"
                        android:textColor="@color/black"
                        android:textColorHint="#9AA5A1"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- TOTAL ROOMS LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="Total Rooms"
                    android:textColor="#34413D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- TOTAL ROOMS -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/Electric_Blue"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTotalRooms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 25"
                        android:inputType="number"
                        android:paddingStart="14dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="15dp"
                        android:textColor="@color/black"
                        android:textColorHint="#9AA5A1"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ROOM DETAILS SECTION -->
                <!-- SECTION HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardBackgroundColor="@color/BackgroundBlue"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="@color/Electric_Blue" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Room Details"
                            android:textColor="#172B26"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Add all available room types"
                            android:textColor="#84908C"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ROOM TYPE LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="Room Type or Room Numbers"
                    android:textColor="#34413D"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <!-- ROOM INPUT + ADD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/Electric_Blue"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRoomType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g. Deluxe Room"
                            android:inputType="textCapWords"
                            android:paddingStart="14dp"
                            android:paddingTop="15dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="15dp"
                            android:textColor="@color/black"
                            android:textColorHint="#9AA5A1"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- ADD BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddRoom"
                        android:layout_width="82dp"
                        android:layout_height="52dp"
                        android:text="ADD"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/Electric_Blue"
                        app:cornerRadius="12dp" />

                </LinearLayout>


                <!-- ADDED ROOMS TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="Added Room Types"
                    android:textColor="#34413D"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <!-- ADDED ROOMS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/BackgroundBlue"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/Text_Blue"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvAddedRooms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:text=""
                        android:textColor="#34413D"
                        android:textSize="14sp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- INFO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/BackgroundBlue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/Electric_Blue" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Please provide accurate property details. These details may be used for verification."
                android:textColor="@color/Text_Blue"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>