<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    tools:context=".OTPActivity">

    <!-- Main Content Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Top Illustration -->
            <androidx.cardview.widget.CardView
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="74dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="OTP Verification"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/otp_verify" />

            </androidx.cardview.widget.CardView>

            <!-- Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Verify Your Phone"
                android:textColor="@color/black"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- Phone Number -->
            <TextView
                android:id="@+id/otpMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/Text_Blue"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Instruction Text -->
            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:maxWidth="310dp"
                android:text="@string/enter_the_otp_code_to_verify_your_phone_number"
                android:textColor="@color/gray_dark"
                android:textSize="14sp" />

            <!-- OTP Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Card Header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Enter Verification Code"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Enter the 4-digit code sent to your phone"
                        android:textColor="@color/gray_dark"
                        android:textSize="12sp" />

                    <!-- OTP Input Fields -->
                    <LinearLayout
                        android:id="@+id/Reg_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:layout_marginBottom="26dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- OTP 1 -->
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/otp1"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:autofillHints="otp"
                            android:background="@drawable/otp_box_background"
                            android:gravity="center"
                            android:hint="•"
                            android:importantForAutofill="yes"
                            android:inputType="number"
                            android:maxLength="1"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:textColor="@color/black"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- OTP 2 -->
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/otp2"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:autofillHints="otp"
                            android:background="@drawable/otp_box_background"
                            android:gravity="center"
                            android:hint="•"
                            android:importantForAutofill="yes"
                            android:inputType="number"
                            android:maxLength="1"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:textColor="@color/black"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- OTP 3 -->
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/otp3"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:autofillHints="otp"
                            android:background="@drawable/otp_box_background"
                            android:gravity="center"
                            android:hint="•"
                            android:importantForAutofill="yes"
                            android:inputType="number"
                            android:maxLength="1"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:textColor="@color/black"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- OTP 4 -->
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/otp4"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:autofillHints="otp"
                            android:background="@drawable/otp_box_background"
                            android:gravity="center"
                            android:hint="•"
                            android:importantForAutofill="yes"
                            android:inputType="number"
                            android:maxLength="1"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:textColor="@color/black"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Verify Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/VerifyOtpBtn"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="14dp"
                        android:onClick="Verify"
                        android:text="Verify OTP"
                        android:textAllCaps="false"
                        android:textColor="@color/Text_Blue"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/BackgroundBlue"
                        app:cornerRadius="12dp"
                        app:elevation="0dp"
                        app:iconGravity="textStart" />

                    <!-- Resend Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Didn't receive the code? "
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/resendBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="4dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="4dp"
                            android:text="Resend OTP"
                            android:textColor="@color/ShapGreen"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>