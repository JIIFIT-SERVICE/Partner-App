<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/Text_Blue"
    android:orientation="vertical"
    android:padding="24dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Profile Avatar Container (Clickable for Photo Upload) -->
        <FrameLayout
            android:id="@+id/layoutHotelProfileImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <!-- Default Initials Avatar -->
            <TextView
                android:id="@+id/tvHotelProfileInitials"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_grey"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:text="GOH"
                android:textColor="@color/Text_Blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Profile Picture once uploaded -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivHotelProfileImage"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:visibility="gone"
                app:civ_border_color="@color/white"
                app:civ_border_width="2dp" />

            <!-- Instagram / Facebook style camera badge -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle_grey"
                android:backgroundTint="@color/white"
                android:padding="3dp"
                android:src="@drawable/camera_alt_24"
                app:tint="@color/Text_Blue" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHotelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Grand Orchid Hotel"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

