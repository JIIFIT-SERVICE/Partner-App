<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background with rounded corners -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#D3D3D3" /> <!-- Light gray color -->
            <stroke
                android:width="2dp"
                android:color="#B0B0B0" /> <!-- Darker gray border -->
        </shape>
    </item>

    <!-- Overlay to make it look locked -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80000000" /> <!-- Semi-transparent black overlay -->
        </shape>
    </item>

</layer-list>
