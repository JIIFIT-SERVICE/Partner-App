<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected State -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ShapGreen" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/ShapGreen" />
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp" />
        </shape>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E0ECE8" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#B0C8C0" />
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5F8F7" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#DCE4E1" />
        </shape>
    </item>

</selector>