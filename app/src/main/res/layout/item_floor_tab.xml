<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutFloorTab"
    android:layout_width="66dp"
    android:layout_height="102dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_floor_card_unselected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvFloorLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Floor"
        android:textColor="#0F172A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFloorNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="3"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFloorRangeStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="(301"
        android:textColor="#0F172A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFloorRangeDash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="#0F172A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFloorRangeEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="324)"
        android:textColor="#0F172A"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
