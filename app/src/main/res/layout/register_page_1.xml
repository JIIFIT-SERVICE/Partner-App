<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <!-- Progress header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR PROFILE"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Personal information"
                android:textColor="#14213D"
                android:textSize="28sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tell us a little about yourself to set up your professional profile."
                android:textColor="#64748B"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Main form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Full name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Full name *"
                android:textColor="#24324B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/reg_name"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter your full name"
                android:inputType="textPersonName|textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#14213D"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <!-- Aadhaar Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Aadhaar number *"
                android:textColor="#24324B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/reg_aadhaar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter 12-digit Aadhaar number"
                android:inputType="number"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#14213D"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <!-- Mobile -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Mobile number *"
                android:textColor="#24324B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.hbb20.CountryCodePicker
                    android:id="@+id/VerifyCountryCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:ccp_showFlag="true"
                    app:ccp_showNameCode="false" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:background="#E2E8F0" />

                <EditText
                    android:id="@+id/reg_mobile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Mobile number"
                    android:inputType="phone"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#14213D"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Email address *"
                android:textColor="#24324B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/reg_email"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#14213D"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <!-- Gender -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Gender *"
                android:textColor="#24324B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButton1"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Male"
                    android:textColor="#24324B"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radioButton2"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Female"
                    android:textColor="#24324B"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radioButton3"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Other"
                    android:textColor="#24324B"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- Date of birth -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Date of birth *"
                android:textColor="#24324B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/reg_age"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:drawableEnd="@drawable/calendar_month_24"
                android:focusable="false"
                android:hint="DD / MM / YYYY"
                android:inputType="none"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#14213D"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/current_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="normal" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:text="City"
                android:textColor="#24324B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/Electric_Blue"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select city"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:inputType="none"
                    android:paddingStart="14dp"
                    android:paddingTop="15dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="15dp"
                    android:textColor="@color/black"
                    android:textColorHint="#9AA5A1"
                    android:drawableEnd="@drawable/arrow_down"
                    android:drawableTint="#9AA5A1"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Permanent address *"
                android:textColor="#24324B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/reg_address"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top|start"
                android:hint="House no., street, city, state and PIN"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="14dp"
                android:textColor="#14213D"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <!-- Profile photo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Profile photo"
                android:textColor="#24324B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Add a clear photo so your profile is easy to recognise."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/upLivePhoto"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="#EEF2FF"
                    android:padding="2dp"
                    android:src="@drawable/ic_avatar_placeholder" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uploadLivePhotoButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="↑   Upload profile photo"
                    android:textAllCaps="false"
                    android:textColor="#1D4ED8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#EFF6FF"
                    app:cornerRadius="12dp"
                    app:strokeColor="#BFDBFE"
                    app:strokeWidth="1dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Your information is used to set up your professional account."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>