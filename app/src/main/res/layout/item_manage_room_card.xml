<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoomContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_room_card_default"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Room Title + Bed Icon + Delete Room Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Room 301"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivBed"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_bed"
            app:tint="#64748B" />

        <ImageView
            android:id="@+id/btnDeleteRoom"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Room"
            android:padding="4dp"
            android:src="@drawable/ic_delete"
            app:tint="#EF4444" />
    </LinearLayout>

    <!-- Subtitle: Room Type -->
    <TextView
        android:id="@+id/tvRoomType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Presidential Suite"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- Status Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Active Session Badge -->
        <TextView
            android:id="@+id/tvActiveSessionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_room_active_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="MASSAGE • 01:00 PM"
            android:textColor="@color/hotel_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Available Badge -->
        <TextView
            android:id="@+id/tvAvailableBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_towers"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Available"
            android:textColor="@color/hotel_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="visible" />

    </LinearLayout>

</LinearLayout>
