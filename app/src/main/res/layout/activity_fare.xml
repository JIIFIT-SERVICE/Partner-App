<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_400sdp"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/_1sdp"
    app:cardCornerRadius="@dimen/_5sdp"
    app:cardElevation="@dimen/_4sdp"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".ViewMoreMenu.FareActivity">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ShapGreen"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:backgroundTint="@color/white"
            android:layout_margin="@dimen/_1sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_4sdp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
     <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="horizontal">
         <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="Up"
             android:textColor="@color/black"
             android:textSize="@dimen/_17ssp"
             android:textStyle="bold"
             android:layout_marginLeft="@dimen/_15sdp"
             />
     </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/uplayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_10sdp">
                    <TextView
                        android:id="@+id/upLocation"
                        android:layout_width="@dimen/_90sdp"
                        android:layout_height="@dimen/_70sdp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:textSize="@dimen/_15ssp"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:drawableLeft="@drawable/location_on_list_24"/>
                    <EditText
                        android:id="@+id/upFare"
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="wrap_content"
                        android:hint="0000"
                        android:textColorHint="@color/Gray"
                        android:textColor="@color/black"
                        android:inputType="number"
                        android:textSize="@dimen/_15ssp"
                        android:drawableLeft="@drawable/rupee_24"/>

                    <ImageButton
                        android:id="@+id/upImage"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:textSize="@dimen/_15ssp"
                        android:layout_marginTop="@dimen/_25sdp"
                        android:background="@drawable/upload"/>
                    <Button
                        android:id="@+id/UpSubmit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_11ssp"
                        android:text="Submit"
                        android:textColor="@color/white"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:backgroundTint="@color/ShapGreen"/>
                </LinearLayout>
                    <TextView
                        android:id="@+id/uppath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:gravity="right"
                        android:layout_marginRight="@dimen/_100sdp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/down"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_10sdp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Down"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_15ssp"
                        android:textStyle="bold"
                        android:layout_marginLeft="@dimen/_15sdp"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/downLayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_5sdp">
                    <AutoCompleteTextView
                        android:id="@+id/downLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_15ssp"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:drawableLeft="@drawable/location_on_list_24"
                        android:hint="Select city"
                        android:inputType="text"
                        android:textColor="@color/black"
                        android:textColorHint="#AB000000"
                        tools:ignore="LabelFor,TextFields"/>
                    <EditText
                        android:id="@+id/downFare"
                        android:layout_width="@dimen/_85sdp"
                        android:layout_height="wrap_content"
                        android:hint="0000"
                        android:textColor="@color/black"
                        android:textColorHint="@color/Gray"
                        android:inputType="number"
                        android:textSize="@dimen/_15ssp"
                        android:drawableLeft="@drawable/rupee_24"/>

                    <ImageButton
                        android:id="@+id/downImage"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:textSize="@dimen/_15ssp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/upload"/>
                    <Button
                        android:id="@+id/downSubmit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_11ssp"
                        android:text="Submit"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/ShapGreen"/>
                </LinearLayout>
                    <TextView
                        android:id="@+id/downpath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:gravity="right"
                        android:layout_marginRight="@dimen/_100sdp"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:padding="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total fare: "
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginLeft="@dimen/_15sdp"/>

                    <TextView
                        android:id="@+id/totaFare"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="00"
                        android:drawableLeft="@drawable/rupee_24"
                        android:textSize="@dimen/_15ssp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textColorHint="@color/Gray"
                        android:layout_marginLeft="@dimen/_15sdp"/>

                </LinearLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>