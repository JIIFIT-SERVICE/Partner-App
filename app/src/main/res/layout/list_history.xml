<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_8sdp"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="@dimen/_6sdp"
    android:id="@+id/BookingHistoryList"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="@dimen/_10sdp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <!-- Booking ID -->
        <TextView
            android:id="@+id/bookId"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="wrap_content"
            android:text="Booking ID: #12345"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/_8sdp" />
        <TextView
            android:id="@+id/review"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:text="Review:"
            android:textColor="@color/black"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold" />
    </LinearLayout>

        <!-- Booking Details Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/_8sdp">

            <TextView
                android:id="@+id/bookingType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="@dimen/_5sdp"
                android:text="Massage At Home"
                android:textColor="@color/black"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:background="@drawable/text_background"
                android:gravity="center" />

<!--            <TextView-->
<!--                android:id="@+id/Fare"-->
<!--                android:layout_width="0dp"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_weight="1"-->
<!--                android:padding="@dimen/_4sdp"-->
<!--                android:text="Fare: ₹1000"-->
<!--                android:textColor="@color/black"-->
<!--                android:textSize="@dimen/_8ssp"-->
<!--                android:textStyle="bold"-->
<!--                android:gravity="center" />-->
        </LinearLayout>

        <!-- Customer Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/_8sdp">

            <TextView
                android:id="@+id/CustomerId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 100000"
                android:textColor="@color/black"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:drawablePadding="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_8sdp" />
            <TextView
                android:id="@+id/CusName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Somnath Das (New)"
                android:textColor="@color/black"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:drawableLeft="@drawable/ic_person"
                android:drawablePadding="@dimen/_4sdp" />
        </LinearLayout>

        <!-- Date and Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/_8sdp">

            <TextView
                android:id="@+id/BookingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/calendar_month_24"
                android:drawablePadding="@dimen/_4sdp"
                android:padding="@dimen/_4sdp"
                android:text="12/12/2024"
                android:textColor="@color/black"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:layout_marginEnd="@dimen/_16sdp" />

            <TextView
                android:id="@+id/BookingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/timer_24"
                android:drawableTint="@color/Blue"
                android:drawablePadding="@dimen/_4sdp"
                android:padding="@dimen/_4sdp"
                android:text="1:00 PM"
                android:textColor="@color/black"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="right"
                android:layout_marginStart="@dimen/_12sdp">

                <ImageView
                    android:layout_width="@dimen/_13sdp"
                    android:layout_height="@dimen/_13sdp"
                    android:src="@drawable/timer_24"
                    android:layout_marginEnd="@dimen/_4sdp"
                    app:tint="@color/Blue"
                    />

                <TextView
                    android:id="@+id/timeDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120 Min"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Massage Description -->
        <TextView
            android:id="@+id/MassageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description: Full body massage session, relaxing therapy."
            android:textColor="@color/black"
            android:textSize="@dimen/_8ssp"
            android:layout_marginBottom="@dimen/_3sdp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_1sdp"
            android:gravity="center_vertical">

            <!-- Review Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            </LinearLayout>

            <!-- Time Duration Section -->

        </LinearLayout>


        <!-- Payment Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="0dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="@dimen/_5sdp"
                android:text="Payment: ₹300"
                android:textColor="@color/black"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/Payment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paid"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/Green"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
