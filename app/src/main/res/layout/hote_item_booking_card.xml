<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <!-- Outer card container with clean rounded stroke -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_booking_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============ 1. HEADER ROW ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Booking ID (#834) -->
            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#834"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- In-Room Tag -->
            <TextView
                android:id="@+id/tvInRoomTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tag_blue"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="In-Room Massage"
                android:textColor="#1A56DB"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Status Tag (COMPLETED / PENDING / CANCELLED) -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pending_pill"
                android:drawableStart="@drawable/ic_pending"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PENDING"
                android:textColor="#B45309"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============ 2. CUSTOMER & ROOM ROW ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rounded Circle Avatar with Person Outline -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_light_gray">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="#64748B" />
            </FrameLayout>

            <!-- Customer Name -->
            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Megha Sharma"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Room Info (Room 112) -->
            <TextView
                android:id="@+id/tvRoomInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Room 112"
                android:textColor="#64748B"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ============ 3. ASSIGNED EXPERT & COMMISSION ROW ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_expert_card_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <!-- Expert Profile Photo (Requirement 2) -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivExpertPhoto"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_person"
                app:civ_border_color="#CBD5E1"
                app:civ_border_width="1dp" />

            <!-- Expert Name & Role -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExpertRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASSIGNED EXPERT"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvExpertName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Rohan Sharma"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Commission Info / Badge (Requirement 7) -->
            <TextView
                android:id="@+id/tvCardCommission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_commission_badge"
                android:drawableStart="@drawable/rupee_24"
                android:drawablePadding="3dp"
                android:drawableTint="#059669"
                android:gravity="center_vertical"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="₹100 Commission"
                android:textColor="#059669"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============ 4. TIME ROW ============ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_booking_time_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/calendar_month_24"
                app:tint="#546E7A" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="07:00 PM • Tue, 26 Aug"
                android:textColor="#1E293B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Kept for compatibility -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>



    </LinearLayout>
</androidx.cardview.widget.CardView>