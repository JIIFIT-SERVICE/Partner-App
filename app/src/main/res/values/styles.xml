<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PaymentOptionCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="strokeColor">@color/gray_dark</item>
        <item name="strokeWidth">1dp</item>
    </style>


    <style name="Widget.MaterialComponents.Slider.Label" parent="Widget.MaterialComponents.Tooltip">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ClickableText">
        <item name="android:textSize">14sp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:padding">8dp</item>
    </style>
    <style name="HoursText">
        <item name="android:textColor">@color/Red</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textStyle">italic</item>
    </style>

    <style name="MoneyText">
        <item name="android:textColor">@color/Green</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textStyle">italic</item>
    </style>
    <style name="CustomWidthDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <!-- Remove min width constraints -->
    </style>


    <style name="ShapeAppearanceOverlay.App.CornerRadius" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item> <!-- You can change this to any value you want -->
    </style>

    <style name="CustomAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">#FFFFFF</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="NonDismissableDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="Widget.Theme.Jifiit.ActionBar.Fullscreen" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="Widget.Theme.Jifiit.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>



    <style name="WhiteAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:background">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
    </style>

</resources>