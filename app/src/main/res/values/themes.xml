<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Jifiit" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/ShapGreen</item>
    </style>
    <style name="Activity.Theme.Jifiit" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- White action bar -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item> <!-- Makes status bar icons black -->
        <item name="android:textColor">#000000</item>
    </style>


    <style name="Base.Theme.Jifiit2" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/ShapGreen</item>
    </style>

    <style name="Theme.Jifiit" parent="Base.Theme.Jifiit" />

    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ShapGreen</item>
        <item name="colorPrimaryDark">@color/ShapGreen</item>
        <item name="colorAccent">@color/BlueCharcoal</item>
        <item name="android:windowBackground">@drawable/splash_activity_background</item>
    </style>

    <style name="ToolbarTitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Theme.Jifiit.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Jifiit.hotel.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Transparent status bar so edge-to-edge content shows -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>  <!-- dark icons -->
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="Theme.Jifiit.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Jifiit.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Base.Theme.Jifiit.Actionbar" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/ShapGreen</item>
    </style>

    <style name="AppTheme.PopMe" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="ButtonStyle">
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/Blue</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <style name="ThemeOverlay.MyPopupTheme" parent="Theme.AppCompat.Light">
        <item name="android:colorBackground">#fff</item>
        <item name="android:textColor">#000</item>
    </style>

    <!-- styles.xml -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_background</item>
    </style>

    <style name="Theme.TreasureBoxes" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/background</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryVariant">@color/gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/background</item>
    </style>


    <style name="CustomNavigationViewText" parent="Theme.MaterialComponents.CompactMenu">
        <!-- This forces the menu item text to be black -->
        <item name="android:textColorPrimary">@color/black</item>
        <!-- Optional: Change the background color of the menu items when selected -->
        <item name="colorPrimary">@color/teal_light</item>
        <!-- Optional: Change the icon color when the item is selected -->
        <item name="colorOnPrimary">@color/Text_Blue</item>
    </style>
    <style name="Theme.Jifiit.Fullscreen" parent="Theme.Jifiit">
        <item name="android:actionBarStyle">@style/Widget.Theme.Jifiit.ActionBar.Fullscreen</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ThemeOverlay.Jifiit.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>

</resources>
