<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="230dp"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#438B96"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E0E0E0" />

        </com.facebook.shimmer.ShimmerFrameLayout>
        <!-- ================================================= -->
        <!-- EXPERT IMAGE -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/ivExpert"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Expert"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person" />


        <!-- ================================================= -->
        <!-- BOTTOM DARK GRADIENT -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_gravity="bottom"
            />


        <!-- ================================================= -->
        <!-- VERIFIED BADGE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvVerified"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_verified"
            android:gravity="center_vertical"
            android:paddingStart="7dp"
            android:paddingEnd="15dp"
            android:text="✓ Verified"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- MORE ICON -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/ivMore"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="3dp"
            android:contentDescription="More"
            android:padding="5dp"
            android:src="@drawable/ic_more_vertical"
            app:tint="@color/white" />


        <!-- ================================================= -->
        <!-- EXPERT INFORMATION -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/expertInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingBottom="8dp">


            <!-- NAME -->

            <TextView
                android:id="@+id/tvExpertName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Subhajit Das"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />


            <!-- EMPLOYEE ID -->

            <TextView
                android:id="@+id/tvEmployeeId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="Employee ID - 312"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />


            <!-- EXPERIENCE -->

            <TextView
                android:id="@+id/tvExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="Experience - 8 months 25 days"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />


            <!-- SELECT BUTTON -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectExpert"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="5dp"
                android:minWidth="88dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Select Now"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="9sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/white"
                app:cornerRadius="7dp"
                app:elevation="0dp" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>