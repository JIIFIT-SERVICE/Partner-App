<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/gradient_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/padding_medium"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Job Vacancy Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_medium"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/white"
                app:layout_constraintWidth_percent="0.9"
                android:layout_marginHorizontal="@dimen/padding_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="JOB VACANCY"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_large"
                        android:textColor="@color/ShapGreen"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/padding_small" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="For Male &amp; Female"
                        android:textSize="@dimen/text_medium"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/padding_small" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Minimum Qualification: 10th pass"
                        android:textSize="@dimen/text_small"
                        android:textColor="@color/Gray"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EARN Every Month"
                        android:textSize="@dimen/text_medium_large"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/padding_large"
                        android:textColor="@color/black"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Up to"
                        android:textSize="@dimen/text_medium"
                        android:layout_marginTop="@dimen/padding_small"
                        android:textColor="@color/dark_ash"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="₹40,000"
                        android:textSize="@dimen/text_large"
                        android:textColor="@color/orange"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/padding_small" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Basic fixed salary: ₹20,000"
                        android:textSize="@dimen/text_small"
                        android:textColor="@color/Gray"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/padding_medium" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Download App Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_small"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/ShapGreen"
                app:layout_constraintWidth_percent="0.9"
                android:layout_marginHorizontal="@dimen/padding_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Download JIIFIT Therapist App"
                        android:textSize="@dimen/text_medium"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/padding_medium" />

                    <!-- Google Play Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:padding="@dimen/padding_small"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@mipmap/google_play_store"
                            android:contentDescription="Google Play Icon"
                            android:layout_marginEnd="@dimen/padding_small" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Get it on Google Play"
                            android:textSize="@dimen/text_small"
                            android:textColor="@android:color/black"
                            android:gravity="center_vertical" />
                    </LinearLayout>

                    <!-- Referral Code Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_marginTop="@dimen/padding_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/padding_medium"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/referral_code"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="Use Referral Code:"
                                android:textSize="@dimen/text_small"
                                android:textStyle="bold"
                                android:textColor="@color/black" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contact Info -->
            <TextView
                android:id="@+id/phone_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_medium"
                android:text="Call us for details and join easily:"
                android:textSize="@dimen/text_small"
                android:textColor="@color/black"
                android:gravity="center" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>