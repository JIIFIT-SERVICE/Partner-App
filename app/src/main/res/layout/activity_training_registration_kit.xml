<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    tools:context=".TrainingRegistrationKitActivity">

    <!-- ============ TOP APP BAR ============ -->
    <LinearLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Training, Registration &amp; Company Kit"
            android:textColor="#0F172A"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <!-- Dummy view to balance the title in the center -->
        <View
            android:layout_width="32dp"
            android:layout_height="32dp" />
    </LinearLayout>

    <!-- ============ SCROLLABLE BODY ============ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============================================== -->
            <!-- CARD 1: PRICING DETAILS                        -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white_rounded16"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header: Clickable to expand/collapse -->
                <LinearLayout
                    android:id="@+id/headerPricing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Price Tag Icon inside circle -->
                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_blue_icon_circle">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Pricing"
                            android:src="@drawable/ic_tag_price"
                            app:tint="#2563EB" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Pricing Details"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivPricingChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Toggle Pricing"
                        android:src="@drawable/arrow_up"
                        app:tint="#0F172A" />
                </LinearLayout>

                <!-- Pricing Items Content -->
                <LinearLayout
                    android:id="@+id/layoutPricingContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <!-- Item 1: Training -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Training Icon"
                            android:src="@drawable/ic_school_cap"
                            app:tint="#2563EB" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Training"
                            android:textColor="#1E293B"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/drawable_dotted_line_horizontal"
                            android:layerType="software" />

                        <TextView
                            android:id="@+id/tvPriceTraining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹599"
                            android:textColor="#1D4ED8"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Item 2: Uniforms Set -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Uniform Icon"
                            android:src="@drawable/ic_tshirt"
                            app:tint="#2563EB" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Uniforms Set"
                            android:textColor="#1E293B"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/drawable_dotted_line_horizontal"
                            android:layerType="software" />

                        <TextView
                            android:id="@+id/tvPriceUniform"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹1399"
                            android:textColor="#1D4ED8"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Item 3: Other Kit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Other Kit Icon"
                            android:src="@drawable/ic_kit_case"
                            app:tint="#2563EB" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Other"
                            android:textColor="#1E293B"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/drawable_dotted_line_horizontal"
                            android:layerType="software" />

                        <TextView
                            android:id="@+id/tvPriceOtherKit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹799"
                            android:textColor="#1D4ED8"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>




                </LinearLayout>
            </LinearLayout>

            <!-- ============================================== -->
            <!-- CARD 2: OPTIONAL MASSAGE BED                   -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/cardMassageBed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_massage_bed"
                android:clickable="true"
                android:elevation="1dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Top Row: Checkbox + Title + Price & Optional -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <!-- Checkbox -->
                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/cbMassageBed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#2563EB"
                        android:checked="false"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp" />

                    <!-- Title -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="Portable Massage Bed"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Price & Optional Column -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPriceBed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+₹20,000"
                            android:textColor="#4338CA"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Optional"
                            android:textColor="#64748B"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2.5dp"
                    android:text="Get More Booking Opportunities!Customers often prefer therapists with a professional massage bed. Selecting this option can make your profile more attractive and help you get more bookings."
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- CARD 3: PAYMENT SUMMARY                        -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/cardPaymentSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white_rounded16"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="PAYMENT SUMMARY"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Row 1: Training, Registration & Company Kit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Training, Registration &amp; Company Kit:"
                        android:textColor="#334155"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/tvPriceKitSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹2,797"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2: Portable Massage Bed -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Portable Massage Bed:"
                        android:textColor="#64748B"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/tvBedSummaryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not Selected (₹0)"
                        android:textColor="#64748B"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Divider Line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E2E8F0" />

                <!-- Row 3: Total Payable Amount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Payable Amount:"
                        android:textColor="#0F172A"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalPayableAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹2,797"
                        android:textColor="#0D9488"
                        android:textSize="18.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- ============================================== -->
            <!-- CARD 2: NEXT STEP                              -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white_rounded16"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header: Clickable to expand/collapse -->
                <LinearLayout
                    android:id="@+id/headerNextStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Bullet List Icon inside circle -->
                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_blue_icon_circle">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Next Step"
                            android:src="@drawable/ic_list_bullet"
                            app:tint="#2563EB" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Next Step"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivNextStepChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Toggle Next Step"
                        android:src="@drawable/arrow_down"
                        app:tint="#0F172A" />
                </LinearLayout>

                <!-- Collapsible summary content for Next Step -->
                <LinearLayout
                    android:id="@+id/layoutNextStepContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="Complete your verification, practical massage skill evaluation, kit training, and policy review to get your profile approved and go live."
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================== -->
            <!-- CARD 3: NEXT STEP DETAILS                      -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white_rounded16"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header: Clickable to expand/collapse -->
                <LinearLayout
                    android:id="@+id/headerNextStepDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Zigzag Steps Icon inside circle -->
                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_blue_icon_circle">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Next Step Details"
                            android:src="@drawable/ic_zigzag_steps"
                            app:tint="#2563EB" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Next Step Details"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivNextStepDetailsChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Toggle Next Step Details"
                        android:src="@drawable/arrow_up"
                        app:tint="#0F172A" />
                </LinearLayout>

                <!-- Stepper Container -->
                <LinearLayout
                    android:id="@+id/layoutNextStepDetailsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- Stepper Left Indicators & Vertical Dotted Line -->
                    <LinearLayout
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <!-- Step 1 Indicator: Blue circle with checkmark -->
                        <FrameLayout
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_blue_circle_step">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:contentDescription="Step 1 Completed"
                                android:src="@drawable/ic_check_white" />
                        </FrameLayout>

                        <!-- Dotted Connector Line 1 -->
                        <View
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/divider_dotted_vertical"
                            android:layerType="software" />

                        <!-- Step 2 Indicator: Clock Circle -->
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Step 2 Pending"
                            android:src="@drawable/ic_clock_outline"
                            app:tint="#64748B" />

                        <!-- Dotted Connector Line 2 -->
                        <View
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:background="@drawable/divider_dotted_vertical"
                            android:layerType="software" />

                        <!-- Step 3 Indicator: Clock Circle -->
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginBottom="4dp"
                            android:contentDescription="Step 3 Pending"
                            android:src="@drawable/ic_clock_outline"
                            app:tint="#64748B" />
                    </LinearLayout>

                    <!-- Stepper Right Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- ============================================== -->
                        <!-- STEP 1: SCROLLABLE MASSAGE LIST                -->
                        <!-- ============================================== -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Practical Skills &amp; Service Training"
                                android:textColor="#0F172A"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Scroll below to review all platform massage services"
                                android:textColor="#94A3B8"
                                android:textSize="11.5sp" />

                            <!-- SCROLLABLE MASSAGE CONTAINER -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvMassageList"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:layout_marginTop="8dp"
                                android:nestedScrollingEnabled="true"
                                android:overScrollMode="ifContentScrolls"
                                android:scrollbars="vertical"
                                tools:itemCount="5"
                                tools:listitem="@layout/item_massage_step" />
                        </LinearLayout>

                        <!-- ============================================== -->
                        <!-- STEP 2: COMPANY T/C & PRIVACY POLICY PENDING   -->
                        <!-- ============================================== -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Company T/c &amp; Privacy &amp; Policy Pending"
                                    android:textColor="#0F172A"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Company will provide training"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Pending Badge -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_pill_pending_amber"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_clock_outline"
                                    app:tint="#D97706" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Pending"
                                    android:textColor="#D97706"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- ============================================== -->
                        <!-- STEP 3: PROFILE LIVE                           -->
                        <!-- ============================================== -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Profile Live"
                                android:textColor="#0F172A"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <!-- Pending Badge -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_pill_pending_amber"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_clock_outline"
                                    app:tint="#D97706" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Pending"
                                    android:textColor="#D97706"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ============================================== -->
    <!-- BOTTOM FIXED FOOTER: PROCESS TO FEES BUTTON    -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/bottomFooterLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <RelativeLayout
            android:id="@+id/btnProcessFees"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_btn_process_fees"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:paddingHorizontal="18dp">

            <!-- Card Icon Left -->
            <ImageView
                android:id="@+id/ivButtonCardIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Card Icon"
                android:src="@drawable/ic_payment_card"
                app:tint="#FFFFFF" />

            <!-- Center Text -->
            <TextView
                android:id="@+id/tvProcessFeesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:letterSpacing="0.02"
                android:text="Process to Kit Training Fees"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <!-- Forward Arrow Right -->
            <ImageView
                android:id="@+id/ivButtonArrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Forward"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#FFFFFF" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>

