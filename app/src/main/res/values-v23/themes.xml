<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Jifiit" parent="Base.Theme.Jifiit">
        <!-- Transparent system bars for edge-to-edge. -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="Activity.Theme.Jifiit" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Action bar / status bar -->
        <item name="colorPrimary">@color/hotel_primary</item>
        <item name="colorPrimaryVariant">@color/hotel_primary_dark</item>
        <item name="android:statusBarColor">@color/hotel_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">#000000</item>
    </style>
</resources>