<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    tools:context=".Influencer.InfluencerTermsActivity">

    <!-- Top Blue Gradient Header Banner -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_influencer_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp">

        <!-- Top Badges & Back Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/arrow_back"
                app:tint="@android:color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Policy Pill Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_partner_guaranteed_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="PARTNER POLICY"
                android:textColor="@android:color/white"
                android:textSize="10.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Header Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false"
            android:text="Terms &amp; Conditions"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:text="JIIFIT Influencer &amp; Partner Program Guidelines"
            android:textColor="#E0E7FF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Scrollable Terms Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp">

            <!-- Overview Banner Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_clean"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Welcome to the JIIFIT Partner Program"
                    android:textColor="#1E293B"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="By joining as a partner and sharing your Referral ID or link, you agree to these Terms &amp; Conditions. Please review the key rules below."
                    android:textColor="#475569"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#F1F5F9" />

                <!-- Highlights Row 1: Real Cash -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_step_circle"
                        android:backgroundTint="#059669"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="✓"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="₹50 Real Cash per verified 1st booking completed"
                        android:textColor="#059669"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Highlights Row 2: Friends Wallet -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_step_circle"
                        android:backgroundTint="#0D62FE"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="✓"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="₹4,999 promotional wallet reward for your friends"
                        android:textColor="#0D62FE"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Highlights Row 3: Zero Fee -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_step_circle"
                        android:backgroundTint="#6366F1"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="✓"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="100% Free to join — no follower count required"
                        android:textColor="#6366F1"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Clauses Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_clean"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Clause 1 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="1. Account Registration"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="Users must provide accurate and verifiable personal or legal entity information when creating an account and registering for the partner program."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- Clause 2 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="2. Services and Bookings"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="All customer bookings are subject to service availability, verified pricing, and the applicable booking and cancellation policies on the JIIFIT platform."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- Clause 3 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="3. Influencer &amp; Partner Program"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="Partners receive a unique Referral ID and custom sharing link to invite new users to the app through social channels, gyms, clients, and word of mouth."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- Clause 4 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="4. Referral Rewards (Friends)"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="Eligible new users receive ₹4,999 in promotional wallet balance after successful registration using your Referral ID and completing their mobile verification."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- Clause 5 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="5. Partner Earnings (Cash Payouts)"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="Partners earn ₹50 in real withdrawable cash each time a referred user successfully completes their first eligible booking and the service is verified. Registration or app installation alone does not qualify for cash payouts."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- Clause 6 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="6. Wallet Balance Rules"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="The ₹4,999 wallet balance credited to referred users is a promotional balance. It is not real currency, cannot be withdrawn to bank accounts, does not expire, and applies exclusively toward eligible bookings on JIIFIT."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- Clause 7 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="7. Fair Usage &amp; Anti-Fraud"
                    android:textColor="#DC2626"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="Self-referrals, fake phone numbers, emulator accounts, fake or automated bookings, and any misuse of the referral mechanism are strictly prohibited. Earnings or rewards will be withheld or permanently cancelled where fraud or abuse is detected."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- Clause 8 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="8. Changes to Terms"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="JIIFIT reserves the right to revise or update these Terms &amp; Conditions periodically. Changes take effect upon publication in the app."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F1F5F9" />

                <!-- Clause 9 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="9. Support &amp; Inquiries"
                    android:textColor="#1E293B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="If you have questions regarding the partner program, referral payouts, or account verification, reach out to our team at:"
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <!-- Email Contact Card -->
                <LinearLayout
                    android:id="@+id/btnSupportEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_email_24"
                        app:tint="#0D62FE" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="jiifitteam@gmail.com"
                        android:textColor="#0D62FE"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#0D62FE" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="10dp"
                    android:background="#F1F5F9" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Company: JIIFIT  •  Effective: October 2026"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FIXED FOOTER -->
    <LinearLayout
        android:id="@+id/termsFooterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#0D62FE"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="I Understand &amp; Agree"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
