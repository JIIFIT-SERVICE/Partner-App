<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/Text_Blue"
    android:orientation="vertical"
    android:padding="24dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <TextView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_circle_grey"
        android:backgroundTint="@color/white"
        android:text="GOH"
        android:gravity="center"
        android:textColor="@color/Text_Blue"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Grand Orchid Hotel"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Partner Concierge Desk"
        android:textColor="#B2DFDB"
        android:textSize="14sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="ACTIVE PROPERTY"
        android:textColor="#80CBC4"
        android:textSize="10sp"
        android:textStyle="bold"/>

    <!-- Property Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_white"
            android:padding="8dp"
            android:text="Grand Orchid ..."
            android:textColor="@color/text_dark"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="#1AFFFFFF"
            android:padding="8dp"
            android:text="XYZ Hotel"
            android:textColor="#B2DFDB"/>
    </LinearLayout>

</LinearLayout>