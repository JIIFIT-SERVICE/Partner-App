<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============ 1. HEADER ROW ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#834"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <!-- In-Room Tag -->
            <TextView
                android:id="@+id/tvInRoomTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="In-Room Massage"
                android:textColor="#1A56DB"
                android:background="@drawable/bg_tag_blue"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Status Tag (COMPLETED / PENDING / CANCELLED) -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pending_pill"
                android:drawableStart="@drawable/ic_pending"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PENDING"
                android:textColor="#B45309"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- 3 Dots Overflow Menu -->
            <ImageView
                android:id="@+id/ivOverflow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:padding="4dp"
                android:src="@drawable/three_dot_black"
                app:tint="#757575"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="More options" />
        </LinearLayout>

        <!-- ============ 2. CUSTOMER INFO ROW ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_light_gray">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    app:tint="#546E7A" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Megha Sharma"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:id="@+id/tvRoomInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Room 112"
                    android:textSize="13sp"
                    android:textColor="#757575" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 3. DATE • TIME • DURATION PILL ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_light_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/calendar_month_24"
                app:tint="#546E7A" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Tue, 26 Aug"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <TextView
                android:id="@+id/tvDateTimeDivider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textSize="13sp"
                android:textColor="#B0BEC5" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_lock_idle_alarm"
                app:tint="#546E7A" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="07:00 PM"
                android:textSize="13sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1h 30m"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1A56DB"
                android:background="@drawable/bg_tag_blue"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@android:drawable/ic_lock_idle_alarm"
                app:drawableTint="#1A56DB" />
        </LinearLayout>

        <!-- ============ 4. ASSIGNED EXPERT & COMMISSION ROW ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_expert_card_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <!-- Expert Profile Photo with Shimmer -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_expert_photo">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shimmer_auto_start="true">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white" />
                </com.facebook.shimmer.ShimmerFrameLayout>

                <ImageView
                    android:id="@+id/ivExpertPhoto"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    android:contentDescription="Expert photo" />
            </FrameLayout>

            <!-- Expert Name & Role -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="50dp"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageView
                        android:id="@+id/ivExpertAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_avatar_placeholder"
                        android:contentDescription="Expert avatar"
                        app:tint="@null" />

                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExpertRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASSIGNED EXPERT"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvExpertName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Rohan Sharma"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Commission Info / Badge -->
            <TextView
                android:id="@+id/tvCardCommission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_commission_badge"
                android:drawableStart="@drawable/rupee_24"
                android:drawablePadding="3dp"
                android:drawableTint="#059669"
                android:gravity="center_vertical"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="₹100 Commission"
                android:textColor="#059669"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============ 5. ACTION BUTTON ============ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCall"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:text="Call Expert"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:textColor="#1A56DB"
            app:icon="@drawable/baseline_call_24"
            app:iconSize="14dp"
            app:iconTint="#1A56DB"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#1A56DB"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp"
            app:elevation="0dp" />
        <!-- ============ ACTION BUTTONS ROW ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Call Expert"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:textColor="#1A56DB"
                app:icon="@drawable/baseline_call_24"
                app:iconSize="13sp"
                app:iconTint="#1A56DB"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#1A56DB"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHelp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Help"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                app:iconSize="13sp"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:backgroundTint="#1A56DB"
                app:cornerRadius="10dp"
                app:elevation="0dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>