<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvAddRoomDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add New Room"
        android:textColor="#1E293B"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAddRoomDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Add a room to Floor 3"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etNewRoomNumber"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_edit_hotel_input"
        android:hint="Room Number (e.g., 313)"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="#1E293B"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etNewRoomType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_edit_hotel_input"
        android:hint="Room Type (e.g., Deluxe Suite)"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="#1E293B"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelNewRoom"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Cancel"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveNewRoom"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="Add Room"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/hotel_primary"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
