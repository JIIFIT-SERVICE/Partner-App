<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#E6EAF0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- ================= LEFT IMAGE ================= -->
        <FrameLayout
            android:layout_width="105dp"
            android:layout_height="135dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shimmer_auto_start="true">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E0E0E0" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <ImageView
                android:id="@+id/ivExpert"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                android:contentDescription="Expert" />

            <!-- Rating chip -->
            <TextView
                android:id="@+id/tvRating"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:background="@drawable/bg_rating_dark"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/gold"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- ================= RIGHT DETAILS ================= -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <!-- Name row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvExpertName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Sourav Das"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_verified"
                    app:tint="#1976D2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetails"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Details"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    app:backgroundTint="#1976D2"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/calendar_month_24"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="12dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <!-- Role -->
            <TextView
                android:id="@+id/tvRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Senior Massage Expert"
                android:textColor="#7B8491"
                android:textSize="11sp" />

            <!-- Availability -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#EAF4FE"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_shield"
                    app:tint="#1976D2" />

                <TextView
                    android:id="@+id/tvAvailability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Available for male client only"
                    android:textColor="#172033"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hometown"
                        android:textColor="#7B8491"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tvHometown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delhi"
                        android:textColor="#172033"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Experience"
                        android:textColor="#7B8491"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tvExperience"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8y 3m"
                        android:textColor="#172033"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lifetime Exp"
                        android:textColor="#7B8491"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tvLifetimeExp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="142h 20m"
                        android:textColor="#172033"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Select button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectExpert"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="90dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Select"
                android:textAllCaps="false"
                android:textColor="#1976D2"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:strokeColor="#1976D2"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>