<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============ HEADER ROW ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Booking ID -->
            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#834"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <!-- In-Room Tag -->

            <!-- Spacer -->
            <TextView
                android:id="@+id/tvInRoomTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tag_blue"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="In-Room Massage"
                android:textColor="#1A56DB"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Pending Tag -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:drawableTint="#FF9800"
                android:drawablePadding="4dp"
                android:textColor="#FF9800"
                android:background="@drawable/bg_tag_pending"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Overflow Menu (3 dots) -->
            <ImageView
                android:id="@+id/ivOverflow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/three_dot_black"
                app:tint="#757575"
                android:visibility="gone"
                android:contentDescription="More options" />
        </LinearLayout>

        <!-- ============ CUSTOMER INFO ROW ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <!-- Avatar Circle -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_light_gray">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    app:tint="#546E7A" />
            </FrameLayout>

            <!-- Name and Room -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Megha Sharma"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:id="@+id/tvRoomInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Room 112"
                    android:textSize="13sp"
                    android:textColor="#757575" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ DATE + TIME TAG ============ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_light_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <!-- Calendar Icon -->
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/calendar_month_24"
                app:tint="#546E7A" />

            <!-- Date -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Tue, 26 Aug"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <!-- Divider Dot -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textSize="13sp"
                android:textColor="#B0BEC5" />

            <!-- Clock Icon -->
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_lock_idle_alarm"
                app:tint="#546E7A" />

            <!-- Time -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="07:00 PM"
                android:textSize="13sp"
                android:textColor="#1A1A1A" />
        </LinearLayout>

        <!-- ============ ACTION BUTTONS ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Call Client"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#1A56DB"
                android:letterSpacing="0.02"
                app:icon="@drawable/baseline_call_24"
                app:iconTint="#1A56DB"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:strokeColor="#1A56DB"
                app:strokeWidth="1.2dp"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDetails"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="View Details"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.02"
                app:icon="@android:drawable/ic_menu_view"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:backgroundTint="#1A56DB"
                app:cornerRadius="12dp"
                app:elevation="0dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>