<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="false"
    tools:context=".Hotel.HotelMainActivity">

    <!-- MAIN CONTENT -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="0dp"
            android:background="@color/hotel_primary"
            android:fitsSystemWindows="false"
            app:elevation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@color/hotel_primary"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:padding="2dp"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 2. Hotel Name & Subtitle -->
                <LinearLayout
                    android:id="@+id/layoutHotelTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnNotification"
                    app:layout_constraintStart_toEndOf="@id/btnMenu"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/hotelName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Grand Orchid - Sector 14"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hotelSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Sector 14 • Main Branch"
                        android:textColor="#E1F5FE"
                        android:textSize="11sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnNotification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Notifications"
                    android:padding="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/white" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/bg_notification_dot" />
                </FrameLayout>

                <!-- 6. Straight Divider Line at Bottom -->
                <View
                    android:id="@+id/bottomDivider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/hotel_primary_dark"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Date Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_date_selector_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/tvYesterday"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="YESTERDAY\nMon • 25 Aug"
                        android:textColor="@color/hotel_primary"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/tvToday"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_active_date_pill"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="TODAY\nTue • 26 Aug"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tvTomorrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="TOMORROW\nWed • 27 Aug"
                        android:textColor="@color/hotel_primary"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                    <ImageView
                        android:id="@+id/ivCalendar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:padding="8dp"
                        android:src="@drawable/calendar_month_24" />

                </LinearLayout>

                <!-- ============================================= -->
                <!-- Filter Chips (checkable, single-select)       -->
                <!-- ============================================= -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Chip 1: All -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All"
                            android:checkable="true"
                            android:clickable="true"
                            android:focusable="true"
                            app:chipBackgroundColor="@color/chip_bg_selector"
                            app:chipMinHeight="36dp"
                            app:chipCornerRadius="18dp"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="false"
                            android:textColor="@color/chip_text_selector" />

                        <!-- Chip 2: Yoga -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_yoga"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Yoga"
                            android:checkable="true"
                            android:clickable="true"
                            android:focusable="true"
                            app:chipIcon="@mipmap/hotel_meditation"
                            app:chipIconTint="@color/chip_text_selector"
                            app:chipBackgroundColor="@color/chip_bg_selector"
                            app:chipMinHeight="36dp"
                            app:chipCornerRadius="18dp"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="false"
                            android:textColor="@color/chip_text_selector" />

                        <!-- Chip 3: In-Room Massage -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_inroom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="In-Room Massage"
                            android:checkable="true"
                            android:clickable="true"
                            android:focusable="true"
                            app:chipIcon="@mipmap/hotel_room"
                            app:chipIconTint="@color/chip_text_selector"
                            app:chipBackgroundColor="@color/chip_bg_selector"
                            app:chipMinHeight="36dp"
                            app:chipCornerRadius="18dp"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="false"
                            android:textColor="@color/chip_text_selector" />

                        <!-- Chip 4: Ayurveda -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_ayurveda"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Ayurveda"
                            android:checkable="true"
                            android:clickable="true"
                            android:focusable="true"
                            app:chipIcon="@mipmap/hotel_ayurveda"
                            app:chipIconTint="@color/chip_text_selector"
                            app:chipBackgroundColor="@color/chip_bg_selector"
                            app:chipMinHeight="36dp"
                            app:chipCornerRadius="18dp"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="false"
                            android:textColor="@color/chip_text_selector" />

                        <!-- Chip 5: Personal Trainer -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_personal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Personal Trainer"
                            android:checkable="true"
                            android:clickable="true"
                            android:focusable="true"
                            app:chipIcon="@mipmap/hotel_gym"
                            app:chipIconTint="@color/chip_text_selector"
                            app:chipBackgroundColor="@color/chip_bg_selector"
                            app:chipMinHeight="36dp"
                            app:chipCornerRadius="18dp"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="false"
                            android:textColor="@color/chip_text_selector" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- RecyclerView for Bookings -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/todolist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="@dimen/_60sdp"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    tools:listitem="@layout/hote_item_booking_card" />

                <!-- Empty State -->
                <include
                    android:id="@+id/Bookings_notFound"
                    layout="@layout/layout_empty_bookings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Floating Bottom Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:background="@drawable/bg_bottom_bar_rounded"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <LinearLayout
                android:id="@+id/btnQr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/qr_code_24"
                    app:tint="#1E3A8A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="QR"
                    android:textColor="#1E3A8A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#E0E0E0" />

            <LinearLayout
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/referal"
                    app:tint="#1E3A8A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Share"
                    android:textColor="#1E3A8A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAddBooking"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.6"
                android:background="@drawable/bg_add_booking_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Add Booking"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- NAVIGATION DRAWER -->
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:headerLayout="@layout/hotel_nav_header_drawer"
            app:menu="@menu/hotel_menu_drawer"
            app:itemTextColor="@color/black"
            app:itemIconTint="@color/Text_Blue"
            app:itemHorizontalPadding="16dp"
            app:itemVerticalPadding="4dp"
            android:background="@color/white"/>

        <include layout="@layout/nav_footer_drawer" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>