<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="false"
    tools:context=".Hotel.ManageRoomsActivity">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <!-- Unified Hotel Header -->
        <include
            android:id="@+id/layoutHotelHeader"
            layout="@layout/layout_hotel_header" />

        <!-- Top Navigation Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Top Row: Title + East & West Towers Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvManageRoomsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Manage Hotel Rooms"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- East & West Towers Badge -->
                <TextView
                    android:id="@+id/tvTowersBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_towers"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="East &amp; West\nTowers"
                    android:textColor="@color/hotel_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvManageRoomsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Real-time guest occupancy &amp; in-room wellness ordering"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- Row with Add Floor, Delete Floor, Add Room -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddFloor"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#EFF6FF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="+ Add Floor"
                    android:textAllCaps="false"
                    android:textColor="@color/hotel_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeColor="#93C5FD"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteFloor"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FEF2F2"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Delete Floor"
                    android:textAllCaps="false"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeColor="#FECACA"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddRoom"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/hotel_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="+ Add Room"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp" />
            </LinearLayout>

            <!-- Floor Selector Pills (Floor 1, 2, 3, 4, 5) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutFloorTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Floor Status Summary -->
            <TextView
                android:id="@+id/tvFloorRoomsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Floor 3 • 12 Active Rooms"
                android:textColor="@color/hotel_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layoutEmptyRooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_bed"
                app:tint="#CBD5E1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No Rooms on this Floor"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Use the '+ Add Room' button above to create hotel rooms."
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Rooms Grid Section -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRoomsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F8FAFC"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_manage_room_card" />

    </LinearLayout>

    <!-- NAVIGATION DRAWER -->
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white"
            app:headerLayout="@layout/hotel_nav_header_drawer"
            app:menu="@menu/hotel_menu_drawer"
            app:itemTextColor="@color/nav_menu_item_text_color"
            app:itemIconTint="@color/nav_menu_item_icon_tint"
            app:itemShapeFillColor="@color/nav_menu_item_shape_color"
            app:itemHorizontalPadding="16dp"
            app:itemVerticalPadding="4dp"/>

        <include layout="@layout/nav_footer_drawer" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
