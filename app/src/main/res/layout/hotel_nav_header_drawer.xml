<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/Text_Blue"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="24dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Profile Avatar Container (Clickable for Photo Upload) -->
        <FrameLayout
            android:id="@+id/layoutHotelProfileImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <!-- Default Initials Avatar -->
            <TextView
                android:id="@+id/tvHotelProfileInitials"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_grey"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:text="GOH"
                android:textColor="@color/Text_Blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Profile Picture once uploaded -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivHotelProfileImage"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:visibility="gone"
                app:civ_border_color="@color/white"
                app:civ_border_width="2dp" />

            <!-- Instagram / Facebook style camera badge -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle_grey"
                android:backgroundTint="@color/white"
                android:padding="3dp"
                android:src="@drawable/camera_alt_24"
                app:tint="@color/Text_Blue" />
        </FrameLayout>

        <!-- Hotel Name and Partner ID with Dropdown -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Hotel Name and Drop Down Button Container -->
            <LinearLayout
                android:id="@+id/layoutHotelBranchDropdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHotelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Grand Orchid Hotel"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Drop Down Button -->
                <ImageView
                    android:id="@+id/btnDropdownBranch"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="Select Branch"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHotelPartnerId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Official Partner JIIFIT LLP"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />

            <!-- Branch Selector Pill / Drop Down Button -->
            <LinearLayout
                android:id="@+id/btnBranchSelectorPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_branch_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_hotel_building"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvSelectedBranchBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Sector 14 (Main Branch)"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>