<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:padding="0dp"
    tools:context=".ReferDialog">

    <!-- Timer Text -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:gravity="center"
        android:text="5"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Close Icon (Initially hidden) -->
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close"
        android:visibility="gone" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvReferTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:text="Refer &amp; Get"
        android:textColor="#000"
        android:textSize="50sp"
        android:textStyle="bold" />

    <!-- Reward Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tvRewardAmount"
        android:layout_width="@dimen/_170sdp"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvReferTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_20sdp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp"
            android:text="₹5000"
            android:textColor="@color/orange"
            android:textSize="25sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Terms -->
    <TextView
        android:id="@+id/tvTerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvRewardAmount"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:padding="5dp"
        android:text="@string/Terms"
        android:textColor="@color/Blue"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Invite Button -->
    <Button
        android:id="@+id/btnInvite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTerm"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/teal_700"
        android:drawablePadding="10dp"
        android:gravity="center"
        android:padding="10dp"
        android:text="Invite"
        android:textColor="#FFF"
        android:textSize="@dimen/_15sdp" />

</RelativeLayout>