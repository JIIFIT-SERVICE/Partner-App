<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    tools:context=".VerificationCenterActivity">

    <!-- ============ TOP APP BAR ============ -->
    <LinearLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_blue_soft"
            android:contentDescription="Back"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="#1D4ED8"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verification Desk"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Office Visit &amp; Kit Collection"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Quick Help Icon -->
        <ImageView
            android:id="@+id/btnToolbarHelp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Help"
            android:padding="6dp"
            android:src="@drawable/ic_help_question_circle"
            app:tint="#64748B"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- ============ SCROLLABLE CONTENT ============ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============================================== -->
            <!-- CARD 1: VERIFIED HERO BANNER (GREEN)          -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_verified_hero_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <!-- Top Row: Badge + Partner ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Pill Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_verified_approved"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verification Approved"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="✓"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Partner ID -->
                    <TextView
                        android:id="@+id/tvPartnerId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="EMPLOYEE ID:\n123456-517662"
                        android:textColor="#E0F2FE"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Hero Title -->
                <TextView
                    android:id="@+id/tvVerifiedHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Your Profile is Now Verified!"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Hero Subtitle Description -->
                <TextView
                    android:id="@+id/tvVerifiedDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Your documents verification, and credentials have been thoroughly checked and approved by the Jiifit team."
                    android:textColor="#D1FAE5"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- CARD 2: ASSIGNED CITY OFFICE ADDRESS           -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_white_card_bordered"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.04"
                        android:text="VISIT JIIFIT'S OFFICE"
                        android:textColor="#64748B"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <!-- City Badge -->
                    <TextView
                        android:id="@+id/tvCityBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_city"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="City: Delhi NCR"
                        android:textColor="#1D4ED8"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- Inner Office Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_office_inner_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Title & Address Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Location Icon -->
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_blue_icon_box">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="Office Location"
                                android:src="@drawable/ic_baseline_location_on_24"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <!-- Office Details -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvOfficeTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Jiifit Regional Office &amp; Verification Center - Delhi NCR"
                                android:textColor="#0F172A"
                                android:textSize="14.5sp"
                                android:textStyle="bold"
                                android:visibility="gone"/>

                            <TextView
                                android:id="@+id/tvOfficeAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="2dp"
                                android:text="Plot 14, Ring Road, Near Moolchand Metro Station, Lajpat Nagar 3, New Delhi - 110024"
                                android:textColor="#64748B"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#F1F5F9" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:text="OFFICE VISITING TIME &amp; DATE"
                        android:textColor="#334155"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                    <!-- Office Timings -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Timings"
                            android:src="@drawable/ic_clock_outline" />

                        <TextView
                            android:id="@+id/tvAssignedTimeSlot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="09:30 AM"
                            android:textColor="#334155"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Date"
                            android:src="@drawable/calendar_month_24"
                            app:tint="#64748B" />

                        <TextView
                            android:id="@+id/tvScheduledDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="12 Jul 2026"
                            android:textColor="#334155"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- Open in Maps Action Link -->
                    <LinearLayout
                        android:id="@+id/btnOpenMaps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Open Office Address in Google Maps"
                            android:textColor="#2563EB"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="Open Link"
                            android:src="@drawable/ic_launch_external"
                            app:tint="#2563EB" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================== -->
            <!-- CARD 4: WHY YOU NEED TO VISIT OUR CENTER       -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_white_card_bordered"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="WHY YOU NEED TO VISIT OUR OFFICE:"
                    android:textColor="#475569"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- Item 1: Collect Company Kit & Uniform -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_why_item_blue"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Kit Uniform Icon"
                            android:src="@drawable/ic_package_box" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="1. Collect Company Kit &amp; Uniform"
                            android:textColor="#1E3A8A"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Collect your uniform and your equipment."
                        android:textColor="#475569"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Item 2: In-Person Training For Additional Services -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_why_item_yellow"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Training Icon"
                            android:src="@drawable/ic_award_ribbon" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="2. In-Person Training For Additional Services"
                            android:textColor="#78350F"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Hands-on practical training and also Companny's terms &amp; policy you will learn for platform services you are not familiar with, so you can increase your earning power."
                        android:textColor="#713F12"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Item 3: Biometric Audit & Policy Briefing -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_why_item_green"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Biometric Icon"
                            android:src="@drawable/ic_shield_check_round" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="3. Biometric Audit &amp; Policy Briefing"
                            android:textColor="#065F46"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Quick physical Aadhaar scan and customer safety etiquette orientation before going live."
                        android:textColor="#047857"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============================================== -->
    <!-- BOTTOM FIXED FOOTER: HELP & SUPPORT BUTTON     -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/bottomFooterLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelpSupport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_help_support"
            android:elevation="3dp"
            android:letterSpacing="0.02"
            android:text="Help &amp; Support"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_support_headset"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>

