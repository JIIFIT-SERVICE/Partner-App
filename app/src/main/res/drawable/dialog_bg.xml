        android:angle="270"
    android:startColor="@color/ShapGreen"
    android:endColor="@color/white"
    android:type="linear" />

    <padding
        android:top="10dp"
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp" />
</shape>