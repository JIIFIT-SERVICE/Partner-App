<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoomContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_room_card_default"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Room Title + Bed Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Room 301"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivBed"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bed"
            app:tint="#64748B" />
    </LinearLayout>

    <!-- Subtitle: Room Type -->
    <TextView
        android:id="@+id/tvRoomType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Presidential Suite"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- Action container: Either Book Session button or Active Session badge -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <!-- Available State: + Book Session -->
        <TextView
            android:id="@+id/btnBookSession"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_book_session"
            android:gravity="center"
            android:text="+ Book Session"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Booked / Active Session State -->
        <TextView
            android:id="@+id/tvActiveSessionBadge"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_room_active_badge"
            android:gravity="center"
            android:text="MASSAGE • 01:00 PM"
            android:textColor="#0F766E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
