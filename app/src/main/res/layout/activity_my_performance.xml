<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".MyPerformance.MyPerformanceActivity">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ShapGreen"
        android:elevation="@dimen/_4sdp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/items1"
        android:layout_below="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/monthYearbtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="@dimen/_110sdp"
                android:backgroundTint="@color/white"
                android:layout_marginRight="@dimen/_110sdp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_marginLeft="@dimen/_5sdp"
                android:backgroundTint="@color/light_Gray"
                app:cardCornerRadius="@dimen/_5sdp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_455sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_20sdp" />

                <TextView
                    android:id="@+id/noData"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_480sdp"
                    android:text="No data available"
                    android:padding="8dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:visibility="gone"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/items1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@navigation/gradients1"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="@dimen/_100sdp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginLeft="@dimen/_10sdp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="Review"
                android:textSize="@dimen/_15ssp"
                android:drawableLeft="@drawable/review1_24"
                android:textStyle="bold"
                android:gravity="left"
                android:backgroundTint="@color/white" />

            <TextView
                android:id="@+id/revToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/Blue"
                android:text="Today: "
                android:textSize="@dimen/_12ssp"
                android:backgroundTint="@color/white" />

            <TextView
                android:id="@+id/revTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/Blue"
                android:text="Total: "
                android:textSize="@dimen/_12ssp"
                android:backgroundTint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/_100sdp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="Upgrads"
                android:textSize="@dimen/_15sdp"
                android:drawableLeft="@drawable/up1_24"
                android:textStyle="bold"
                android:gravity="left"
                android:backgroundTint="@color/white" />

            <TextView
                android:id="@+id/UpToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/Blue"
                android:text="Today: "
                android:textSize="@dimen/_12ssp"
                android:backgroundTint="@color/white" />

            <TextView
                android:id="@+id/UpTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/Blue"
                android:text="Total: "
                android:textSize="@dimen/_12ssp"
                android:backgroundTint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_20sdp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:drawableLeft="@drawable/hourglass_full_24"
                    android:gravity="left"
                    android:text="Hours"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/HoursToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:text="Today: "
                android:textColor="@color/Blue"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:id="@+id/HoursTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:text="Total: "
                android:textColor="@color/Blue"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
